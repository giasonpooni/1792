{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1792.game/schemas/historical_event.schema.json",
  "title": "1792 Historical Event",
  "description": "Optional Mahan-scoped historical-state event stub. Does not extend or replace world-state.v1.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "date_range",
    "location",
    "actors",
    "evidence",
    "canon_class",
    "historical_outcome",
    "knowledge",
    "gameplay"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "historical-event.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "date_range": {
      "type": "object",
      "required": [
        "start_year",
        "end_year"
      ],
      "additionalProperties": false,
      "properties": {
        "start_year": {
          "type": "integer"
        },
        "end_year": {
          "type": "integer"
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "season",
            "day",
            "approximate"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "place_id"
      ],
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "certainty": {
          "type": "string",
          "enum": [
            "documented",
            "reconstructed",
            "authored"
          ]
        },
        "related_place_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional related location stub ids (e.g. Gujranwala settlement/roads)."
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "household",
              "faction"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "confidence",
          "evidence_class"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "none"
            ]
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "canon_class": {
      "type": "string",
      "enum": [
        "source_attested",
        "reconstructed",
        "game_canon",
        "authored_fiction"
      ]
    },
    "historical_outcome": {
      "type": "object",
      "required": [
        "fixed"
      ],
      "additionalProperties": false,
      "properties": {
        "fixed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": [
        "direct_observers",
        "report_routes",
        "propagation_delay",
        "player_knowledge"
      ],
      "additionalProperties": false,
      "properties": {
        "direct_observers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "channel"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              }
            }
          }
        },
        "propagation_delay": {
          "type": "integer",
          "minimum": 0
        },
        "player_knowledge": {
          "type": "boolean"
        }
      }
    },
    "gameplay": {
      "type": "object",
      "required": [
        "playable",
        "intervention_scope",
        "historical_invariants"
      ],
      "additionalProperties": false,
      "properties": {
        "playable": {
          "type": "boolean"
        },
        "intervention_scope": {
          "type": "string",
          "enum": [
            "none",
            "observe",
            "report",
            "order_around",
            "alter_outcome"
          ]
        },
        "historical_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile_scope": {
          "type": "string"
        }
      }
    }
  }
}
